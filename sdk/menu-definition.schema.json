{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://absolute-control-panel.invalid/sdk/menu-definition.schema.json",
  "title": "Absolute Control Panel ABI v1 menu definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetAbiVersion", "module", "pages"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "targetAbiVersion": { "const": 1 },
    "module": { "$ref": "#/$defs/module" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 95 },
    "description": { "type": "string", "maxLength": 191 },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sections"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["readOnly", "requiresRestart", "advanced", "layoutInline", "requiresConfirmation"] }
    },
    "commonOptionProperties": {
      "id": { "$ref": "#/$defs/identifier" },
      "label": { "$ref": "#/$defs/label" },
      "description": { "$ref": "#/$defs/description" },
      "flags": { "$ref": "#/$defs/flags" }
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "toggle" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "flags": { "$ref": "#/$defs/flags" }
      }
    },
    "integer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "widget", "label", "minimum", "maximum", "step"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "integer" },
        "widget": { "const": "slider" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "flags": { "$ref": "#/$defs/flags" },
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" },
        "step": { "type": "integer", "minimum": 1 }
      }
    },
    "float": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "widget", "label", "minimum", "maximum", "step"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "float" },
        "widget": { "const": "slider" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "flags": { "$ref": "#/$defs/flags" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "action" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "flags": { "$ref": "#/$defs/flags" }
      }
    },
    "bindingCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "keyboard": { "type": "boolean" },
        "mouse": { "type": "boolean" },
        "controller": { "type": "boolean" },
        "modifiers": { "type": "boolean" },
        "clearable": { "type": "boolean" }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "inputBinding" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "flags": { "$ref": "#/$defs/flags" },
        "capabilities": { "$ref": "#/$defs/bindingCapabilities" }
      }
    },
    "recordCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "recordCollection" },
        "label": { "$ref": "#/$defs/label" },
        "description": { "$ref": "#/$defs/description" },
        "flags": { "$ref": "#/$defs/flags" }
      }
    },
    "option": {
      "oneOf": [
        { "$ref": "#/$defs/toggle" },
        { "$ref": "#/$defs/integer" },
        { "$ref": "#/$defs/float" },
        { "$ref": "#/$defs/action" },
        { "$ref": "#/$defs/inputBinding" },
        { "$ref": "#/$defs/recordCollection" }
      ]
    }
  }
}
