{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://absolute-control-panel.invalid/catalog.schema.json",
  "title": "Absolute Control Panel development catalogue",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "product", "runtime", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogVersion": {"type": "string", "minLength": 1},
    "product": {"const": "Absolute Control Panel"},
    "runtime": {"type": "object"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "status", "confidence", "tags"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
          "kind": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "minLength": 1},
          "tags": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
