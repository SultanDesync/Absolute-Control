{
  "name": "menu-throttle",
  "description": "HOTAS's Throttle Setup page: the live graph pinned above settings split into sections, and the graph following edits. Cancels every edit, so nothing is saved. Read the layout from the screenshots. Needs the HOTAS profile.",
  "fixture": "on-foot-ship-technician",
  "tests": [
    {
      "id": "pinned-graph",
      "description": "Opens Throttle Setup, moves between its sections, changes a zone with a key and with a drag, and cancels.",
      "steps": [
        { "command": "show_probe" },
        { "expect": "bridge_model_published", "detail": "accepted=true" },
        { "command": "open_page:absolute.hotas/hotas-throttle" },
        { "expect": "bridge_page_applied", "detail": ["page=hotas-throttle controls=", "active=true"], "timeoutSeconds": 5 },
        { "waitMs": 800 },
        { "screenshot": "landmarks" },

        { "command": "test_pointer:220,365" }, { "waitMs": 200 },
        { "command": "test_click" },
        { "expect": "pointer_down_hit", "timeoutSeconds": 3 },
        { "waitMs": 300 },
        { "screenshot": "positional-zones" },

        { "command": "nav_down" }, { "waitMs": 100 },
        { "command": "nav_down" }, { "waitMs": 300 },
        { "screenshot": "cruise-selected" },
        { "command": "key_hold:2E:60" }, { "waitMs": 40 },
        { "command": "key_hold:2E:60" }, { "waitMs": 40 },
        { "command": "key_hold:2E:60" }, { "waitMs": 40 },
        { "command": "key_hold:2E:60" }, { "waitMs": 40 },
        { "command": "key_hold:2E:60" }, { "waitMs": 40 },
        { "command": "key_hold:2E:60" }, { "waitMs": 40 },
        { "command": "key_hold:2E:60" }, { "waitMs": 40 },
        { "command": "key_hold:2E:60" }, { "waitMs": 300 },
        { "screenshot": "cruise-wider" },

        { "command": "test_pointer:1110,297" }, { "waitMs": 200 },
        { "command": "test_mouse_button:1" },
        { "expect": "pointer_down_hit", "timeoutSeconds": 3 },
        { "waitMs": 200 },
        { "command": "test_pointer:1180,297" }, { "waitMs": 200 },
        { "command": "test_pointer:1250,297" }, { "waitMs": 200 },
        { "screenshot": "cruise-dragging" },
        { "command": "test_mouse_button:0" }, { "waitMs": 300 },
        { "screenshot": "cruise-dragged" },

        { "command": "test_pointer:220,403" }, { "waitMs": 200 },
        { "command": "test_click" },
        { "expect": "pointer_down_hit", "timeoutSeconds": 3 },
        { "waitMs": 300 },
        { "screenshot": "rate" },
        { "command": "test_pointer:220,517" }, { "waitMs": 200 },
        { "command": "test_click" },
        { "expect": "pointer_down_hit", "timeoutSeconds": 3 },
        { "waitMs": 300 },
        { "screenshot": "precise" },

        { "command": "key_hold:2D:60" }, { "waitMs": 500 },
        { "screenshot": "cancelled" },

        { "command": "test_pointer:220,365" }, { "waitMs": 200 },
        { "command": "test_click" },
        { "expect": "pointer_down_hit", "timeoutSeconds": 3 },
        { "waitMs": 200 },
        { "command": "test_pointer:600,391" }, { "waitMs": 200 },
        { "command": "test_click" },
        { "expect": "pointer_down_hit", "timeoutSeconds": 3 },
        { "waitMs": 500 },
        { "screenshot": "interpretation-open" },
        { "command": "test_pointer:600,391" }, { "waitMs": 200 },
        { "command": "test_click" },
        { "waitMs": 300 },

        { "command": "hide_probe" },
        { "expect": "menu_message_hide", "detail": "result=0" }
      ]
    },
    {
      "id": "other-live-pages",
      "description": "The other plain pages with live panels, which measure their rows the same way.",
      "steps": [
        { "command": "show_probe" },
        { "expect": "bridge_model_published", "detail": "accepted=true" },
        { "command": "open_page:absolute.hotas/hotas-aiming" },
        { "expect": "bridge_page_applied", "detail": ["page=hotas-aiming controls=", "active=true"], "timeoutSeconds": 5 },
        { "waitMs": 500 },
        { "screenshot": "aiming" },
        { "command": "open_page:absolute.hotas/hotas-devices" },
        { "expect": "bridge_page_applied", "detail": ["page=hotas-devices controls=", "active=true"], "timeoutSeconds": 5 },
        { "waitMs": 500 },
        { "screenshot": "devices" },
        { "command": "hide_probe" },
        { "expect": "menu_message_hide", "detail": "result=0" }
      ]
    }
  ]
}
