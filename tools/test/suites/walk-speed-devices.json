{
  "name": "walk-speed-devices",
  "description": "The Walk Speed page with real controllers connected: the axis list fills in and opens. Changes nothing, so no settings are written. Needs a profile without AbsoluteHOTAS.",
  "fixture": "on-foot-ship-technician",
  "tests": [
    {
      "id": "off-by-default",
      "description": "With no settings file the feature stays off and leaves movement alone.",
      "steps": [
        { "expect": "walk_hook_installed", "since": "run" },
        { "expect": "walk_settings", "detail": "enabled=0", "since": "run" },
        { "expect": "walk_page_registered", "since": "run" },
        { "expect": "walk_gauge_registered", "since": "run" }
      ]
    },
    {
      "id": "axis-list",
      "description": "The Speed axis row lists the connected axes.",
      "steps": [
        { "command": "show_probe" },
        { "expect": "menu_message_show", "detail": "result=0", "timeoutSeconds": 5 },
        { "command": "open_page:absolute.control/walk-speed" },
        { "expect": "bridge_page_applied", "detail": ["page=walk-speed", "active=true"], "timeoutSeconds": 5 },
        { "waitMs": 300 },
        { "screenshot": "page" },
        { "command": "nav_down" },
        { "waitMs": 100 },
        { "command": "nav_down" },
        { "waitMs": 100 },
        { "command": "nav_down" },
        { "waitMs": 200 },
        { "screenshot": "axis-row" },
        { "command": "accept" },
        { "waitMs": 400 },
        { "screenshot": "axis-list" },
        { "command": "probe_escape" },
        { "waitMs": 200 },
        { "command": "hide_probe" }
      ]
    }
  ]
}
