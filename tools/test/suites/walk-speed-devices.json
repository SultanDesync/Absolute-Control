{
  "name": "walk-speed-devices",
  "description": "The Walk Speed page with real controllers connected: the axis capture starts and a parked set of controllers doesn't trigger it. Changes nothing, so no settings are written. Needs a profile without AbsoluteHOTAS.",
  "fixture": "on-foot-ship-technician",
  "tests": [
    {
      "id": "loads",
      "description": "The feature loads with whatever settings are saved.",
      "steps": [
        { "expect": "walk_hook_installed", "since": "run" },
        { "expect": "walk_settings", "since": "run" },
        { "expect": "walk_page_registered", "since": "run" },
        { "expect": "walk_gauge_registered", "since": "run" }
      ]
    },
    {
      "id": "axis-capture-parked",
      "description": "With nobody touching the controllers, the capture stays waiting, and Esc cancels it.",
      "steps": [
        { "command": "show_probe" },
        { "expect": "menu_message_show", "detail": "result=0", "timeoutSeconds": 5 },
        { "command": "open_page:absolute.control/walk-speed" },
        { "expect": "bridge_page_applied", "detail": ["page=walk-speed", "active=true"], "timeoutSeconds": 5 },
        { "waitMs": 300 },
        { "screenshot": "page" },
        { "command": "nav_down" },
        { "waitMs": 100 },
        { "command": "nav_down" },
        { "waitMs": 100 },
        { "command": "nav_down" },
        { "waitMs": 200 },
        { "screenshot": "axis-row" },
        { "command": "accept" },
        { "expect": "walk_axis_capture", "detail": "started", "timeoutSeconds": 2 },
        { "waitMs": 3000 },
        { "screenshot": "axis-capture-waiting" },
        { "absent": "walk_axis_capture", "detail": "captured" },
        { "absent": "walk_speed", "detail": "source=virtual" },
        { "command": "probe_escape" },
        { "expect": "walk_axis_capture", "detail": "cancelled", "timeoutSeconds": 2 },
        { "waitMs": 200 },
        { "command": "hide_probe" },
        { "waitMs": 8000 },
        { "absent": "walk_settings_saved", "since": "run" },
        { "absent": "input_poll_gap", "detail": "ms=2" },
        { "absent": "input_poll_gap", "detail": "ms=3" }
      ]
    }
  ]
}
